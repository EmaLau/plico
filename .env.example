# Copia questo file in .env e modifica i valori che ti servono.

# Indirizzo e porta su cui pubblicare il servizio.
# 127.0.0.1 = solo da questo computer; 0.0.0.0 = da tutta la rete (il servizio non ha login: vedi README).
UPDF_BIND=127.0.0.1
UPDF_PORT=8080

# Dimensione massima di ogni file caricato, in MB (0 = nessun limite).
MAX_UPLOAD_MB=0
# Dimensione massima dei risultati di una richiesta, in MB.
MAX_OUTPUT_MB=4096
# Lavori pesanti eseguiti insieme; gli altri aspettano.
MAX_PARALLEL=2
# Megapixel massimi per pagina in 'PDF in immagini'
MAX_PAGE_MPX=50

# Password della pagina /admin per le chiavi API (vuota = pagina disattivata).
UPDF_ADMIN_PASSWORD=
# false = pagina /admin senza password (poi si cambia dalla pagina stessa).
UPDF_ADMIN_LOGIN=true
# Valore iniziale dell'obbligo della chiave per le API (poi si cambia dalla pagina /admin).
API_REQUIRE_KEY=false

# Word, Excel, PowerPoint <-> PDF con un Convertitore universale (vuoto = strumenti nascosti).
CONVERTER_URL=
CONVERTER_API_KEY=
# Cartella magica in Nextcloud (vuoto = spenta). Usa una password per le app, non quella dell'account.
NEXTCLOUD_URL=
NEXTCLOUD_USER=
NEXTCLOUD_PASSWORD=
# In alternativa: percorso (dentro il container) di un file con la password, es. /work/data/nextcloud-password
NEXTCLOUD_PASSWORD_FILE=
NEXTCLOUD_MAGIC_DIR=Universal-PDF
NEXTCLOUD_POLL_SECONDS=60

# Risorse massime del container.
UPDF_CPUS=4
UPDF_MEMORY=3G

# Utente che esegue il servizio dentro il container (proprietario dei file temporanei).
UPDF_UID=1000
UPDF_GID=1000
TZ=Europe/Rome

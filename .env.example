# Copia questo file in .env e modifica i valori che ti servono.

# Indirizzo e porta su cui pubblicare il servizio.
# 127.0.0.1 = solo da questo computer; 0.0.0.0 = da tutta la rete (il servizio non ha login: vedi README).
UPDF_BIND=127.0.0.1
UPDF_PORT=8080

# Dimensione massima di ogni file caricato, in MB.
MAX_UPLOAD_MB=2048
# Megapixel massimi per pagina in 'PDF in immagini'
MAX_PAGE_MPX=50

# Risorse massime del container.
UPDF_CPUS=4
UPDF_MEMORY=3G

# Utente che esegue il servizio dentro il container (proprietario dei file temporanei).
UPDF_UID=1000
UPDF_GID=1000
TZ=Europe/Rome
